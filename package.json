{
  "name": "dilm-platform",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.20"
  },
  "scripts": {
    "deploy:dev": "pnpm --filter infra deploy --stage dev",
    "deploy:staging": "pnpm --filter infra deploy --stage staging",
    "deploy:production": "pnpm --filter infra deploy --stage production",
    "diff": "pnpm --filter infra diff",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm --filter @dilm/cms typecheck"
  },
  "devDependencies": {
    "@dilm/config": "workspace:*",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
