{
  "name": "@dilm/cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "generate:importmap": "pnpm payload generate:importmap",
    "generate:types": "pnpm payload generate:types",
    "grant:super-admin": "pnpm payload run src/seed/grant-super-admin.ts",
    "lint": "eslint .",
    "migrate": "pnpm payload migrate",
    "migrate:create": "pnpm payload migrate:create",
    "migrate:status": "pnpm payload migrate:status",
    "payload": "node --env-file-if-exists=../../.env node_modules/payload/bin.js",
    "seed:tenants": "pnpm payload run src/seed/seed-tenants.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify:login-lockout": "pnpm payload run src/seed/verify-login-lockout.ts"
  },
  "dependencies": {
    "@dilm/runtime-config": "workspace:*",
    "@dilm/shared-types": "workspace:*",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-multi-tenant": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "graphql": "^16.14.2",
    "next": "16.3.6",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@dilm/config": "workspace:*",
    "@types/node": "^22.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^10.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
