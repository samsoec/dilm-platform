# Local development settings. Copy to .env (gitignored) and adjust if needed.
# Docker Compose reads the same file, so the containers and the apps agree
# on ports, credentials and bucket names.

# Where @dilm/runtime-config reads from: "env" (this file) or "aws"
# (Secrets Manager + SSM). Deployed functions leave it unset, which means aws.
RUNTIME_CONFIG_SOURCE=env

# Always Jakarta (UU PDP data residency). Also the SES and SQS region on AWS.
AWS_REGION=ap-southeast-3

# Image architecture for every container. linux/arm64 matches the Lambda
# runtime; on an x86 machine without arm64 emulation use linux/amd64.
DOCKER_PLATFORM=linux/arm64

# Postgres 16. DATABASE_USER is created as a non-superuser owning
# DATABASE_NAME, like payload_app on Aurora. The master "postgres" user is
# only for admin work.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=dilm
DATABASE_USER=payload_app
DATABASE_PASSWORD=payload_app
DATABASE_SSL=false
POSTGRES_MASTER_PASSWORD=postgres

# Payload's signing key. Any long random string works locally.
PAYLOAD_SECRET=local-dev-only-not-a-real-secret

# S3 via MinIO. Leave S3_ENDPOINT empty to talk to real S3.
# MinIO console: http://localhost:9001 (log in with the keys below).
S3_PUBLIC_BUCKET=dilm-local-public
S3_PRIVATE_BUCKET=dilm-local-cv-private
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Email via Mailpit. Leave SMTP_HOST empty to send through SES instead.
# Mailpit inbox: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# CV queue via ElasticMQ, only started with `docker compose --profile queue up`.
# Leave CV_QUEUE_URL empty if you are not running it.
# ElasticMQ UI: http://localhost:9325
CV_QUEUE_URL=http://localhost:9324/000000000000/dilm-local-cv
SQS_ENDPOINT=http://localhost:9324
SQS_ACCESS_KEY_ID=local
SQS_SECRET_ACCESS_KEY=local

# Job-application platform webhook, called by the CV consumer. Optional
# locally; point it at a request catcher (e.g. https://webhook.site) to test.
JOB_PLATFORM_WEBHOOK_URL=
JOB_PLATFORM_WEBHOOK_SECRET=
